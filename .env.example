# 请复制此文件为 .env 并填入你的真实配置

# ==================================================================
# AI 模型配置（在GUI设置界面中或者env中配置后才能正常使用本地AI助手服务）
# ==================================================================

# API 密钥 — 使用云端 API 时必填（如 OpenAI、并行科技等）
# 如果使用本地部署(ollama,llamacpp)则可留空
AI_API_KEY=your-api-key-here

# 以下为AI模型配置：
AI_API_TYPE=llamacpp              # 可选（严格填写可选项中的单词）: openai | ollama | llamacpp | anthropic
AI_API_URL=http://127.0.0.1:8080  # 默认使用本地 API 地址
AI_MODEL_NAME=local-model         # 模型名称，例如 deepseek-v4-pro（使用云端模型），gemma4:e2b（使用本地模型）


# ===================================================================
# 讯飞语音服务凭证配置（在GUI设置界面中或者env中配置后才能正常使用AI女友语音服务）
# ===================================================================

# 获取凭证步骤：
# 1. 注册讯飞开放平台：https://www.xfyun.cn
# 2. 创建应用，获取 APPID、API Key、API Secret
# 3. 开通「语音听写」和「超拟人语音合成」服务

# 应用ID
XFYUN_APP_ID=your_app_id_here

# API密钥
XFYUN_API_KEY=your_api_key_here

# API密钥密文
XFYUN_API_SECRET=your_api_secret_here

# 语音听写 WebSocket 地址（不要修改，调用地址一般官网一样，修改为其他可能使服务不可用）
XFYUN_ASR_URL=wss://iat-api.xfyun.cn/v2/iat

# 语音合成 WebSocket 地址（不要修改，调用地址一般官网一样，修改为其他可能使服务不可用）
# 超拟人语音合成 API
XFYUN_TTS_URL=wss://cbm01.cn-huabei-1.xf-yun.com/v1/private/mcd9m97e6

# TTS音色（可选，默认 x6_lingxiaoxuan_pro）
# 超拟人系列比如：x6_lingxiaoxuan_pro, x6_wumeinv_pro(超拟人女声), x6_lingfeiyi_pro(超拟人男声)
XFYUN_VOICE_TYPE=x6_lingxiaoxuan_pro
